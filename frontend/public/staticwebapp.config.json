{
  "routes": [
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/me", "statusCode": 404 },
    { "route": "/.auth/*", "statusCode": 404 },
    { "route": "/signin.html", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-store" } },
    { "route": "/signin.js", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-store" } },
    { "route": "/access-denied.html", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-store" } },
    { "route": "/signout.html", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-store" } },
    { "route": "/signout.js", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-store" } },
    { "route": "/access.css", "allowedRoles": ["anonymous"] },
    { "route": "/assets/*", "allowedRoles": ["anonymous"] },
    { "route": "/licenses/*", "allowedRoles": ["anonymous"] },
    { "route": "/sources/ffmpeg-audio-core-v1-source.tar.gz", "allowedRoles": ["anonymous"], "headers": { "Content-Type": "application/gzip" } },
    { "route": "/icon-192.png", "allowedRoles": ["anonymous"] },
    { "route": "/icon-512.png", "allowedRoles": ["anonymous"] },
    { "route": "/icons.svg", "allowedRoles": ["anonymous"] },
    { "route": "/favicon.svg", "allowedRoles": ["anonymous"] },
    { "route": "/manifest.webmanifest", "allowedRoles": ["anonymous"] },
    { "route": "/.vite/manifest.json", "allowedRoles": ["anonymous"] },
    { "route": "/api/*", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-store" } },
    { "route": "/local-media/*", "statusCode": 404 },
    { "route": "/*", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "max-age=0, must-revalidate" } }
  ],
  "platform": { "apiRuntime": "node:22" },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
  },
  "mimeTypes": { ".wav": "audio/wav", ".ttf": "font/ttf", ".webmanifest": "application/manifest+json", ".wasm": "application/wasm", ".gz": "application/gzip", ".tar.gz": "application/gzip" }
